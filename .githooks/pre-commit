#!/usr/bin/env bash
set -euo pipefail

echo "[pre-commit] 1/4 TypeScript typecheck..."
npm run typecheck

echo "[pre-commit] 2/4 Running Vitest suite..."
npm test

echo "[pre-commit] 3/4 Running production build..."
npm run build

echo "[pre-commit] 4/4 Checking Graphify knowledge graph freshness..."
node scripts/check-graph-freshness.mjs --staged

echo "[pre-commit] All checks passed!"
